# Copy to .env and fill in real values. Never commit .env.
# Compose reads this from the repo root: docker compose --env-file .env ...

# --- Database ---
POSTGRES_USER=baltic
POSTGRES_PASSWORD=change-me
POSTGRES_DB=baltic

# --- Admin bootstrap (first boot only; creates the initial admin user) ---
BOOTSTRAP_ADMIN_EMAIL=you@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-too

# --- Ingestion ---
# There is no ingestion config here anymore -- a fresh install seeds one
# "simulator" data source (no credentials, fake traffic) via migration
# 0005_data_sources, and everything else (adding a real source like
# AISStream, its API key, bounding boxes, enabling/disabling sources) is
# done from Admin -> Data sources in the app itself once it's running.
# See workers/ingest/worker/sources.py.

# --- Retention (position history) ---
# These are only the fallback used if the retention_settings table is
# somehow empty -- the live, editable values are the Admin page's
# "Retention & storage" section, not these. A vessel nobody's watching
# keeps a short window; one on any watchlist keeps a much longer one.
RETENTION_DEFAULT_HOURS=24
RETENTION_WATCHLISTED_DAYS=365
RETENTION_SWEEP_INTERVAL_SECONDS=3600

# --- Cookies ---
# Set to false ONLY for plain-http local development without TLS.
COOKIE_SECURE=true

# --- Web port ---
# Host port the "web" container is published on. Change this if it
# collides with something else already running on your machine.
WEB_PORT=8090

# --- Cloudflare Tunnel (optional) ---
# Only used if you start the "cloudflare" compose profile (see
# docs/runbooks/deploy.md, "Exposing it beyond localhost"). Leave unset if
# you're not using a Cloudflare Tunnel. Get this from the Cloudflare Zero
# Trust dashboard: Networks -> Tunnels -> create a tunnel -> Docker
# connector -> copy the token from the install command it shows you.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Demo mode ---
# Set to true to run a public, read-only instance: every mutating action
# (alert rules, geofences, watchlists, admin settings) is blocked with a
# 403, both server-side and in the UI. This does NOT add anonymous
# access -- visitors still need BOOTSTRAP_ADMIN_EMAIL/PASSWORD above, so
# it's on you to decide whether/how to share that login. See
# docs/adr/0009-demo-mode.md.
DEMO_MODE=false
