# Copy to .env and fill in real values. Never commit .env.
# Compose reads this from the repo root: docker compose --env-file .env ...

# --- Database ---
POSTGRES_USER=baltic
POSTGRES_PASSWORD=change-me
POSTGRES_DB=baltic

# --- Admin bootstrap (first boot only; creates the initial admin user) ---
BOOTSTRAP_ADMIN_EMAIL=you@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-too

# --- Ingestion ---
# "simulator" (default, no credentials) or "aisstream" -- but do not
# switch to aisstream until docs/data-source-register.md's capture and
# terms review are marked done (see workers/ingest/README.md).
INGEST_ADAPTER=simulator

# Only used when INGEST_ADAPTER=aisstream. Free signup: https://aisstream.io
AISSTREAM_API_KEY=

# Optional: override the default Stockholm/Gothenburg/Öresund bounding
# boxes as a JSON string, e.g. for the capture spike's --box flag or a
# different coverage area. Leave unset to use the defaults in
# workers/ingest/worker/config.py.
AISSTREAM_BOUNDING_BOXES=

# --- Cookies ---
# Set to false ONLY for plain-http local development without TLS.
COOKIE_SECURE=true

# --- Web port ---
# Host port the "web" container is published on. Change this if it
# collides with something else already running on your machine.
WEB_PORT=8090
