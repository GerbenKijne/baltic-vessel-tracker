# Template for a SECOND, separate stack -- a public, read-only demo
# instance, run alongside your real one on the same host. Copy to
# `.env.demo` and fill in real values. Never commit `.env.demo`.
#
# This is NOT loaded automatically -- it only exists if you deliberately
# bring up a second Compose project pointed at it, with a distinct
# project name so containers/volumes/networks don't collide with your
# main instance:
#
#   docker compose -p baltic-tracker-demo -f infra/compose/docker-compose.yml \
#     --env-file .env.demo up -d --build
#
# See docs/runbooks/deploy.md, "Hosted demo" section, for the full walkthrough
# (including the Cloudflare Tunnel routing and the one-time step to seed a
# sample watchlist/alert before flipping DEMO_MODE on for good).

# --- Database ---
# A fresh volume under the demo's own project name -- doesn't touch your
# real instance's data. The password only matters to itself.
POSTGRES_USER=baltic
POSTGRES_PASSWORD=change-me
POSTGRES_DB=baltic
# Different from the main stack's 15432 so both can run on the same host
# at once without a port collision.
POSTGRES_PORT=15433

# --- Admin bootstrap ---
# This login is meant to be public -- put it on the landing page. Anyone
# using it can only look, not touch (DEMO_MODE below blocks every
# mutating action), so there's nothing to protect by keeping it secret.
BOOTSTRAP_ADMIN_EMAIL=demo@example.com
BOOTSTRAP_ADMIN_PASSWORD=sail-the-baltic

# --- Retention ---
# Short on both counts -- a demo instance doesn't need a year of history
# for vessels nobody's actually watching long-term.
RETENTION_DEFAULT_HOURS=24
RETENTION_WATCHLISTED_DAYS=30
RETENTION_SWEEP_INTERVAL_SECONDS=3600

# --- Cookies ---
COOKIE_SECURE=true

# --- Web port ---
# Different from the main stack's 8090 so both can run at once. The
# Cloudflare Tunnel's second Public Hostname (demo.your-domain.example)
# points at this port on the host -- see docs/runbooks/deploy.md.
WEB_PORT=8091

# --- Cloudflare Tunnel ---
# Leave this unset here. The demo shares your EXISTING tunnel (a second
# Public Hostname routed to http://<host-LAN-IP>:8091, not a second
# cloudflared connector) -- see docs/runbooks/deploy.md, "Hosted demo".
CLOUDFLARE_TUNNEL_TOKEN=

# --- Demo mode ---
# The whole point of this second stack. Every mutating action (alert
# rules, geofences, watchlists, admin settings) is blocked with a 403,
# both server-side and in the UI. Leave this false during the one-time
# setup step (seeding a sample watchlist/alert so visitors see a
# populated app), then set it true before sharing the URL.
DEMO_MODE=true
